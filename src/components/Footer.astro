---
import Wordmark from './Wordmark.astro';
import PixelCanvas from './PixelCanvas.astro';
const year = new Date().getFullYear();
const applyHref = 'mailto:sales@little.cloud?subject=Select26%20application';
---
<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <Wordmark size="sm" />
      <p class="site-footer__meta">
        <strong>Hosted by Lorem Events</strong><br />
        October 2 · San Francisco<br />
        Demo template · Little-Devs
      </p>
      <nav class="footer-links" aria-label="Footer">
        <a href="#speakers">Speakers</a>
        <a href="#agenda">Agenda</a>
        <a href="#tickets">Tickets</a>
        <a href="#sponsors">Sponsors</a>
        <a href="mailto:devs@little.cloud">devs@little.cloud</a>
        <a href="https://github.com/Little-Devs/template-select26">Theme / repo</a>
      </nav>
    </div>
    <div class="site-footer__cta">
      <a class="btn" href={applyHref}>Apply via Luma</a>
      <span style="font-family:var(--font-mono);font-size:0.7rem;letter-spacing:0.05em;text-transform:uppercase;color:var(--ink-muted);">
        © {year} Little-Devs · MIT
      </span>
    </div>
  </div>
  <div class="footer-rail" aria-hidden="true">
    <PixelCanvas variant="hero" live={false} tall={false} label="" />
  </div>
</footer>
