---
import Wordmark from './Wordmark.astro';
const ticketsHref = 'mailto:sales@little.cloud?subject=Select26%20tickets';
---
<header class="site-header" id="top">
  <div class="container site-header__grid">
    <div>
      <Wordmark />
    </div>

    <div>
      <p class="site-header__copy">
        Curated day of talks by a generic host
        and the industry’s best builders.
      </p>
      <span class="header-arrow" aria-hidden="true">↓</span>
      <p class="site-header__meta">
        <strong>Lorem Day · Month XX</strong>
        100 Ipsum Avenue<br />
        Dolor City
      </p>
    </div>

    <div class="site-header__cta">
      <p>In-person and application only.</p>
      <p>From $XX per person.</p>
      <a class="btn" href={ticketsHref}>Get tickets</a>
    </div>
  </div>
</header>
