---
interface Props {
  tall?: boolean;
  live?: boolean;
  variant?: 'hero' | 'tickets';
  label?: string;
}
const { tall = false, live = true, variant = 'hero', label = 'Decorative pixel canvas' } = Astro.props;
---
<div
  class:list={['pixel-canvas', { 'pixel-canvas--tall': tall, 'pixel-canvas--live': live }]}
  data-pixel-canvas={variant}
  role="img"
  aria-label={label}
>
  <canvas class="pixel-canvas__surface" aria-hidden="true"></canvas>
  <div class="pixel-canvas__overlay" aria-hidden="true"></div>
  <slot />
</div>
