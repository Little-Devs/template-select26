---
const speakers = [
  { name: 'Jane Doe', role: 'CEO, Acme Labs', initials: 'JD' },
  { name: 'Alex Rivera', role: 'CTO, Northwind', initials: 'AR' },
  { name: 'Sam Okonkwo', role: 'Partner, Horizon Ventures', initials: 'SO' },
  { name: 'Maya Chen', role: 'Founder, Parallel Systems', initials: 'MC' },
  { name: 'Jordan Blake', role: 'Partner Emeritus, Summit Capital', initials: 'JB' },
  { name: 'Riley Nguyen', role: 'Co-Founder, Standard Works', initials: 'RN' },
  { name: 'Taylor Brooks', role: 'Co-Founder & CEO, Entirely', initials: 'TB' },
  { name: 'Casey Morgan', role: 'Platform Engineering, Continuum', initials: 'CM' },
  { name: 'Avery Patel', role: 'Head of Product, Continuum', initials: 'AP' },
  { name: 'Quinn Sato', role: 'Infrastructure Lead, Acme Labs', initials: 'QS' },
  { name: 'Harper Ellis', role: 'Head of Databases, Northwind', initials: 'HE' },
  { name: 'To be announced', role: '', initials: 'TO BE ANNOUNCED', tba: true },
];

const rail = 'B C C C C B B B B B C C D E F G A → ↓ ↗ ← ↑ ↙ · × +';
---
<section class="section" id="speakers" aria-labelledby="speakers-title">
  <div class="container">
    <div class="pixel-rail" aria-hidden="true">
      {rail.split(' ').map((c) => <span>{c}</span>)}
    </div>
    <h2 class="section__title" id="speakers-title">Speakers</h2>
    <ul class="speakers-grid" role="list">
      {
        speakers.map((s) => (
          <li class="speaker-card">
            <div class:list={['avatar', { 'avatar--tba': s.tba }]} aria-hidden="true">
              <span>{s.initials}</span>
            </div>
            <div>
              {!s.tba && <h3>{s.name}</h3>}
              {!s.tba && <p>{s.role}</p>}
              {s.tba && <h3 class="visually-hidden">{s.name}</h3>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
