---
const sponsors = [
  { name: 'Acme Labs', headline: true },
  { name: 'Northwind', headline: false },
  { name: 'Ipsum Co', headline: false },
  { name: 'Dolor Systems', headline: false },
  { name: 'Lorem Cloud', headline: true },
  { name: 'Sitware', headline: false },
  { name: 'Amet Grid', headline: false },
  { name: 'Announcing soon', tba: true },
];
---
<section class="section" id="sponsors" aria-labelledby="sponsors-title">
  <div class="container">
    <h2 class="section__title" id="sponsors-title">Sponsors</h2>
    <div class="sponsors-grid">
      {
        sponsors.map((s) =>
          s.tba ? (
            <div class="sponsor-card sponsor-card--tba" aria-label="Announcing soon">
              <span>Announcing soon</span>
            </div>
          ) : (
            <div class:list={['sponsor-card', { 'sponsor-card--headline': s.headline }]}>
              {s.headline && <span class="sponsor-badge">Headline sponsor</span>}
              {s.name}
            </div>
          )
        )
      }
    </div>
  </div>
</section>
