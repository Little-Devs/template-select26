---
import PixelCanvas from './PixelCanvas.astro';
const applyHref = 'mailto:sales@little.cloud?subject=Select26%20tickets';
---
<section class="tickets" id="tickets" aria-labelledby="tickets-title">
  <PixelCanvas variant="tickets" tall={true} live={true} label="Tickets call-to-action canvas">
    <div class="tickets__row">
      <a class="btn" href={applyHref}>Apply via Luma</a>
      <h2 class="tickets__title" id="tickets-title">
        <span class="tickets__glyph" aria-hidden="true">
          <i></i><i></i><i></i>
          <i></i><i></i><i></i>
        </span>
        Tickets available now
      </h2>
    </div>
  </PixelCanvas>
</section>
