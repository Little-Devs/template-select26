      "backgroundName": "Cream paper",
      "backgroundAlt": "#f4ece6",
      "backgroundAltName": "Cream deep",
      "ink": "#0b0e0d",
      "inkName": "Ink",
      "hairline": "#d3cfcb",
      "hairlineName": "Hairline"
    }
  },
  "sections": [
    "3-col header (wordmark / info / Luma CTA)",
    "Full-bleed pixel-art canvas",
    "Speakers 6-col grid",
    "Value props",
    "Agenda tabs + schedule",
    "Tickets CTA over canvas",
    "Monochrome mosaic",
    "Sponsors",
    "Footer"
  ],
  "useCases": [
