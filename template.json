{
  "id": "select26",
  "name": "Select26",
  "version": "1.0.0",
  "description": "Cream-paper Select26-style conference landing. Astro 5 SSG with 3-col header, pixel canvases, speakers, agenda tabs, Luma-style tickets CTA, mosaic, and sponsors.",
  "category": "landing-page",
  "subcategory": "event/conference",
  "repository": "https://github.com/Little-Devs/template-select26",
  "demoUrl": "https://select26.little.website/",
  "previewImage": "https://select26.little.website/preview.png",
  "techStack": {
    "framework": "Astro",
    "version": "5",
    "styling": "Hand CSS (design tokens)",
    "scripting": "None"
  },
  "features": [
    "Single-page event landing (Astro 5 SSG)",
    "3-column info header (not conventional nav)",
    "CSS pixel-art canvases (hero + tickets + footer rail)",
    "Speakers grid with dithered CSS initials + TBA",
    "Agenda tabs: Main Stage / Build Stage (CSS-only)",
    "Luma-style Apply CTA (mailto demo)",
    "Monochrome CSS photo mosaic",
    "Sponsors bordered cards with headline badges",
    "~1088px content width, thin borders, rectangular buttons",
    "Skip link, reduced-motion, responsive 375/768/1280",
    "Cloudflare Pages _headers (Steve bar CSP)"
  ],
  "aesthetic": {
    "style": "Cream paper conference",
    "description": "Warm cream paper background, ink typography, brand green accents, mono ticket chips, diagonal hatch canvas",
    "fonts": {
      "display": "Manrope",
      "sans": "Inter",
      "mono": "IBM Plex Mono (Departure Mono feel)"
    },
    "colors": {
      "primary": "#3ECF8E",
      "primaryName": "Brand green",
      "accent": "#00482f",
      "accentName": "Deep green",
      "accentLight": "#94e6b7",
      "accentLightName": "Light green",
